# qtrobot-llama-cpp server configuration
# Edit this file and restart the service to apply changes:
#   sudo systemctl restart qtrobot-llama-cpp

# Model preset. Available presets:
#   qwen3.5-9b (default), qwen3.8-27b, gemma4-12b
LLAMA_MODEL_PRESET=qwen3.5-9b

# Downloaded model files are kept here and shared between presets.
LLAMA_MODEL_DIR=/opt/luxai/qtrobot_llama_cpp/models

LLAMA_HOST=0.0.0.0
LLAMA_PORT=8080
LLAMA_N_GPU_LAYERS=999
LLAMA_N_PARALLEL=2
LLAMA_CTX_SIZE=65536

# Set to false to disable the built-in web UI (adds --webui none).
LLAMA_WEBUI=true
